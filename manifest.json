{
  "manifest_version": 3,
  "name": "Kicker",
  "version": "1.0.1",
  "description": "A Chrome extension that hides unwanted streamers on kick.com. DENEME",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/kicker32.png",
      "32": "icons/kicker32.png",
      "48": "icons/kicker32.png",
      "128": "icons/kicker32.png"
    }
  },
  "icons": {
    "16": "icons/kicker32.png",
    "32": "icons/kicker32.png",
    "48": "icons/kicker32.png",
    "128": "icons/kicker32.png"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://kick.com/*"
      ],
      "js": [
        "src/content/content.js"
      ]
    }
  ]
}